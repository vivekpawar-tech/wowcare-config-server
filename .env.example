# ==============================================================================
# Environment Variables Template for WowCare Config Server
# ==============================================================================
# Copy this file to .env and fill in the actual values
# DO NOT commit the .env file to version control

# Server Configuration
SERVER_PORT=8888
SPRING_PROFILES_ACTIVE=local

# Eureka Configuration
EUREKA_SERVER_URL=http://localhost:8761/eureka/
EUREKA_REGISTER=true
EUREKA_FETCH_REGISTRY=true
HOSTNAME=localhost

# Git Repository Configuration
CONFIG_GIT_URI=git@github.com:Atoconn-System-Labs-Private-Limited/wowcare-configuration-service.git
CONFIG_GIT_BRANCH=main

# Keycloak Configuration
KEYCLOAK_ISSUER_URI=http://localhost:8080/realms/wowcare
KEYCLOAK_JWK_SET_URI=http://localhost:8080/realms/wowcare/protocol/openid-connect/certs

# Logging Configuration
LOGGING_LEVEL_ROOT=INFO

# ==============================================================================
# Environment-Specific Examples
# ==============================================================================

# LOCAL ENVIRONMENT
# SPRING_PROFILES_ACTIVE=local
# EUREKA_SERVER_URL=http://localhost:8761/eureka/
# KEYCLOAK_ISSUER_URI=http://localhost:8080/realms/wowcare

# DEV ENVIRONMENT
# SPRING_PROFILES_ACTIVE=dev
# EUREKA_SERVER_URL=http://dev-eureka:8761/eureka/
# KEYCLOAK_ISSUER_URI=http://dev-keycloak:8080/realms/wowcare

# QA ENVIRONMENT
# SPRING_PROFILES_ACTIVE=qa
# EUREKA_SERVER_URL=http://qa-eureka:8761/eureka/
# KEYCLOAK_ISSUER_URI=http://qa-keycloak:8080/realms/wowcare

# UAT ENVIRONMENT
# SPRING_PROFILES_ACTIVE=uat
# EUREKA_SERVER_URL=http://uat-eureka:8761/eureka/
# KEYCLOAK_ISSUER_URI=http://uat-keycloak:8080/realms/wowcare

# STAGING ENVIRONMENT
# SPRING_PROFILES_ACTIVE=staging
# EUREKA_SERVER_URL=http://staging-eureka:8761/eureka/
# KEYCLOAK_ISSUER_URI=http://staging-keycloak:8080/realms/wowcare

# PRODUCTION ENVIRONMENT
# SPRING_PROFILES_ACTIVE=prod
# EUREKA_SERVER_URL=http://prod-eureka:8761/eureka/
# KEYCLOAK_ISSUER_URI=http://prod-keycloak:8080/realms/wowcare
